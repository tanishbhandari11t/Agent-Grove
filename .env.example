# Server
PORT=8787
HOST=127.0.0.1
# Production (Render): HOST=0.0.0.0 and CORS_ORIGIN=https://your-app.onrender.com
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development

# OpenRouter — keep this key on the server only (never commit real keys)
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=Agent Grove

# Optional: use a stronger model for the Scribe report step
OPENROUTER_REPORT_MODEL=
